# VITE_SUPABASE_URL: Supabase project API URL.
# Find it in your Supabase project settings under Project Settings > API.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# VITE_SUPABASE_ANON_KEY: Supabase anonymous/public API key.
# Safe to expose in client-side code; access is enforced via Row Level Security (RLS).
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# After deploy: add your production URL to Supabase Dashboard →
# Authentication → URL Configuration → Site URL + Redirect URLs
# (needed for e-posta doğrulama and şifre sıfırlama links).
