# Copy to `.env` (gitignored). Never commit real keys or passwords.

# Supabase project API URL (Project Settings → API)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Supabase anonymous/public API key (RLS-protected; still do not paste production keys into issues/PRs)
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional — local DEV demo login buttons on Auth screen only
# VITE_DEMO_CLIENT_EMAIL="client@example.com"
# VITE_DEMO_LAWYER_EMAIL="lawyer@example.com"
# VITE_DEMO_PASSWORD="use-a-strong-local-password"

# Seed script only (server-side; never use VITE_ prefix)
# DEMO_PASSWORD="use-a-strong-local-password"
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# After deploy: add your production URL to Supabase Dashboard →
# Authentication → URL Configuration → Site URL + Redirect URLs
# (needed for e-posta doğrulama and şifre sıfırlama links).
